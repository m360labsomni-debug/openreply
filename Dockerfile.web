# Web app container for OpenReply (self-hosted)
# Pins Node 24 because Prisma 7.x requires Node 20.19+, 22.12+, or 24+.
FROM node:24-slim

WORKDIR /app

# Prisma needs openssl at runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Generate the Prisma client and build the Next.js app
RUN npx prisma generate && npm run build

ENV PORT=3000
EXPOSE 3000

# Apply pending migrations at startup, then serve the app
CMD ["sh", "-c", "npx prisma migrate deploy && npm run start"]
